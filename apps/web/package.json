{
  "name": "@openlink/web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "theme:build": "astryx theme build ./src/themes/openlink.ts",
    "theme:check": "astryx theme build ./src/themes/openlink.ts --check",
    "generate-routes": "vite build",
    "build": "bun run theme:build && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply openlink --local",
    "check-types": "wrangler types && tsc --noEmit",
    "lint": "oxlint src",
    "test": "bun test src"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.14",
    "@astryxdesign/theme-neutral": "^0.7.14",
    "@aws-sdk/client-sesv2": "^3.1172.0",
    "@better-auth/api-key": "1.7.22",
    "@better-auth/passkey": "1.7.22",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@legendapp/state": "^3.0.0-beta.48",
    "@openlink/contracts": "workspace:*",
    "@openlink/db": "workspace:*",
    "@openlink/domain": "workspace:*",
    "@openlink/email": "workspace:*",
    "@orpc/arktype": "2.0.0-beta.50",
    "@orpc/client": "2.0.0-beta.50",
    "@orpc/contract": "2.0.0-beta.50",
    "@orpc/effect": "2.0.0-beta.50",
    "@orpc/json-schema": "2.0.0-beta.50",
    "@orpc/openapi": "2.0.0-beta.50",
    "@orpc/server": "2.0.0-beta.50",
    "@orpc/tanstack-query": "2.0.0-beta.50",
    "@smithy/fetch-http-handler": "^5.8.1",
    "@standard-server/core": "^0.16.0",
    "@stylexjs/stylex": "^0.19.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/charts": "1.5.0",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-hotkeys": "^0.27.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "@vis.gl/react-maplibre": "8.1.3",
    "arktype": "^2.2.9",
    "better-auth": "^1.7.22",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "drizzle-orm": "^0.45.1",
    "effect": "^4.1.4",
    "maplibre-gl": "6.17.0",
    "qrcode-generator": "1.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "tldts": "^7.4.24"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.14",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^4.20260305.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.6",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxlint": "^1.35.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.163.0"
  }
}
