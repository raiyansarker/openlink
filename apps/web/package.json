{
  "name": "@openlink/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply openlink-local --local",
    "db:seed:bootstrap-invite": "wrangler d1 execute openlink-local --local --file ./scripts/seed-bootstrap-invite.sql",
    "check-types": "wrangler types && tsc --noEmit",
    "lint": "oxlint src",
    "test": "bun test src"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.14",
    "@astryxdesign/theme-neutral": "^0.7.14",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@legendapp/state": "^3.0.0-beta.48",
    "@openlink/contracts": "workspace:*",
    "@openlink/db": "workspace:*",
    "@openlink/domain": "workspace:*",
    "@orpc/arktype": "2.0.0-beta.50",
    "@orpc/contract": "2.0.0-beta.50",
    "@orpc/effect": "2.0.0-beta.50",
    "@orpc/openapi": "2.0.0-beta.50",
    "@orpc/server": "2.0.0-beta.50",
    "@standard-server/core": "^0.16.0",
    "@stylexjs/stylex": "^0.19.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "better-auth": "^1.5.4",
    "drizzle-orm": "^0.45.1",
    "effect": "^4.1.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.14",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^4.20260305.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxlint": "^1.35.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  }
}
