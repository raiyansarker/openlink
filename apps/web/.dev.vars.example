# Copy to .dev.vars for local development. Production values are set as Worker secrets/vars.

# Auth
BETTER_AUTH_SECRET=dev-only-change-me-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to call the auth API, comma separated.
BETTER_AUTH_TRUSTED_ORIGINS=
# Email and password sign-in is on unless this is "false".
EMAIL_PASSWORD_SIGN_IN=true

# OAuth providers switch on only when both the id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Invite create responses include the raw token only when this is "true" (keep it off in production).
EXPOSE_INVITE_TOKENS_IN_API=true

# Custom domains: "memory" needs no credentials. Use "cloudflare" with the CF_* values to test SaaS hostnames.
DOMAIN_PROVIDER=memory
CF_API_TOKEN=
CF_ZONE_ID=
CF_SAAS_CNAME_TARGET=
CF_SAAS_CUSTOM_ORIGIN=

# Email: `vite dev` sends every email to Mailtrap Local through its API on 127.0.0.1:3550
# (`brew install mailtrap-local`, then run `mailtrap-local`). Read them at http://127.0.0.1:3550.
# Nothing to set here; the sender comes from EMAIL_FROM in wrangler.jsonc.

# A built Worker sends through Resend: set RESEND_API_KEY as a Worker secret (`wrangler secret put RESEND_API_KEY`).
# Uncomment to try real delivery with `vite preview`.
# RESEND_API_KEY=
