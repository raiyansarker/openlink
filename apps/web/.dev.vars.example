BETTER_AUTH_SECRET=dev-only-change-me-use-openssl-rand-base64-32
BOOTSTRAP_ORG_INVITE_TOKEN=local-bootstrap-invite-token

# The app's own origin: dashboard, sign-in and passkeys live here, and links
# without a custom domain are served from it. No trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# memory: domains are only simulated. cloudflare: real Cloudflare for SaaS (needs the CF_* values below).
DOMAIN_PROVIDER=memory

# "true" makes invite responses include the raw invite token, so you can accept
# invites locally without email. Leave it unset (or "false") in production.
EXPOSE_INVITE_TOKENS_IN_API=true

CF_API_TOKEN=
CF_ZONE_ID=
CF_SAAS_CNAME_TARGET=
CF_SAAS_CUSTOM_ORIGIN=
