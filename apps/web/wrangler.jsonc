{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openlink-web",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "main": "@tanstack/react-start/server-entry",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openlink-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      // Profile pictures and workspace logos. Local dev uses an emulated bucket.
      "binding": "MEDIA",
      "bucket_name": "openlink-media"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "openlink_clicks"
    }
  ],
  "ratelimits": [
    {
      // Wrong-password attempts on protected links, per link and visitor IP.
      "name": "LINK_PASSWORD_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "DOMAIN_PROVIDER": "memory",
    "BETTER_AUTH_URL": "http://localhost:3000",
    "EXPOSE_INVITE_TOKENS_IN_API": "true"
  }
}
