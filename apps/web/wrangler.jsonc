{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openlink",
	"compatibility_date": "2026-11-12",
	"compatibility_flags": [
		"nodejs_compat",
		"enable_request_signal"
	],
	// Wraps the TanStack Start handler and hosts the email workflow.
	"main": "src/server.ts",
	// Reachable only through the custom domain: no *.workers.dev URL, no per-version preview URLs.
	// Set here because dashboard toggles are reset by the next deploy.
	"workers_dev": false,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "openlink",
			"database_id": "e100f9f2-742f-486a-bda5-da9fc8e42c80",
			"migrations_dir": "../../packages/db/drizzle"
		}
	],
	"r2_buckets": [
		{
			// Profile pictures and workspace logos. Local dev uses an emulated bucket.
			"binding": "MEDIA",
			"bucket_name": "openlink"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "openlink"
		}
	],
	"vars": {
		// Sender for outgoing email (not a secret). The address or domain must be verified in Amazon SES.
		"EMAIL_FROM": "OpenLink <no-reply@raiyansarker.com>"
	},
	"workflows": [
		{
			// One run per outgoing email: render, then send with retries (see src/server/email/workflow.ts).
			"name": "openlink-email",
			"binding": "EMAIL_WORKFLOW",
			"class_name": "EmailWorkflow"
		}
	],
	"ratelimits": [
		{
			// Wrong-password attempts on protected links, per link and visitor IP.
			"name": "LINK_PASSWORD_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 3,
				"period": 60
			}
		}
	],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  // Readable stack traces in Workers Logs (the Vite plugin emits the Worker's maps).
  "upload_source_maps": true,
}
