{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "version": "0.1.0",
  "name": "OpenLink",
  "description": "Shorten the current page with your OpenLink workspace.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "chromium:permissions": ["activeTab", "storage", "tabs", "scripting"],
  "firefox:permissions": ["activeTab", "storage", "tabs"],
  "commands": {
    "open-overlay": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Shorten this page with OpenLink"
    }
  },
  "chromium:web_accessible_resources": [{ "resources": ["overlay/index.html"], "matches": ["<all_urls>"] }],
  "firefox:web_accessible_resources": ["overlay/index.html"],
  "background": {
    "chromium:service_worker": "background.ts",
    "firefox:scripts": ["background.ts"]
  },
  "chromium:optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "firefox:optional_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "chromium:action": {
    "default_title": "OpenLink",
    "default_icon": { "16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png" },
    "default_popup": "popup/index.html"
  },
  "firefox:browser_action": {
    "default_title": "OpenLink",
    "default_icon": { "16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png" },
    "default_popup": "popup/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "extension@openlink.dev",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
